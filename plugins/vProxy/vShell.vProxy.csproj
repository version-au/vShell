<Project Sdk="Microsoft.NET.Sdk">
  <!-- The vProxy plugin: your vProxy's hosts and whether their apps answer, on a bar and in a widget, its notifications, and vShell's
       colours sent to vProxy's pages. Made only with the plugin API; it keeps its own version. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>vShell.vProxy</AssemblyName>
    <RootNamespace>VProxy</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>1.2.0</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- compiled against vShell; at run time it uses the vShell that loads it (never copied next to the plugin) -->
    <ProjectReference Include="..\..\vShell.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
