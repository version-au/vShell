<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>vShell.ClaudeUsage</AssemblyName>
    <RootNamespace>ClaudeUsage</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>2.1.0</Version>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>
  <ItemGroup>
    <!-- compiled against vShell; at run time it uses the vShell that loads it (never copied next to the plugin) -->
    <ProjectReference Include="..\..\vShell.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
