<Project Sdk="Microsoft.NET.Sdk">

  <!-- The Mail (IMAP) plugin: vShell.Mail.dll, built for exactly the vShell version in ..\..\vShell.csproj
       (read from there, so there's only one version number to bump). build.cmd puts it in dist\ with its .sha256. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>vShell.Mail</AssemblyName>
    <RootNamespace>Mail</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <VShellProject>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\..\vShell.csproj'))</VShellProject>
    <Version>$([System.Text.RegularExpressions.Regex]::Match($(VShellProject), '&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;').Groups[1].Value)</Version>
    <!-- Sign in with Google's OAuth client: google-client.txt next to this file holds "clientid secret" on one line (kept out of git).
         Without it the build has no client of its own and people put theirs on the Plugins page. -->
    <GoogleClientFile>$(MSBuildThisFileDirectory)google-client.txt</GoogleClientFile>
    <GoogleClient Condition="Exists('$(GoogleClientFile)')">$([System.IO.File]::ReadAllText('$(GoogleClientFile)').Trim())</GoogleClient>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyMetadata Include="GoogleClient" Value="$(GoogleClient)" />
  </ItemGroup>

  <ItemGroup>
    <!-- compiled against vShell; at run time it uses the vShell that loads it (never copied next to the plugin) -->
    <ProjectReference Include="..\..\vShell.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

</Project>
