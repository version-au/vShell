<Project Sdk="Microsoft.NET.Sdk">
  <!-- The vTrace plugin (vTrace's changes and outages on a bar and in a widget), made only with the plugin API. It keeps its own version. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>vShell.VTrace</AssemblyName>
    <RootNamespace>VShellVTrace</RootNamespace>
    <EnableDynamicLoading>true</EnableDynamicLoading>
    <Version>2.1.1</Version>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <DebugType>none</DebugType>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>
  <ItemGroup>
    <!-- compiled against vShell; at run time it uses the vShell that loads it (never copied next to the plugin) -->
    <ProjectReference Include="..\..\vShell.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>
</Project>
